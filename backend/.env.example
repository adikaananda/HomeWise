LINGKUNGAN=pengembangan
SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
JWT_KEDALUWARSA_JAM=72

DATABASE_PATH=./data/homewise.db
DIR_UNGGAHAN=./data/unggahan
MAKS_UNGGAHAN_MB=10
SEED_OTOMATIS=true

CORS_ORIGINS=http://localhost:5173
URL_FRONTEND=http://localhost:5173

# Pilihan: simulasi | remote | asli
AI_MODE=simulasi
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_DETIK=60

# Opsional: narasi LLM via OpenRouter (kosongkan untuk templat statis bawaan)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
# OPENROUTER_FALLBACK_MODELS=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_DETIK=25
# OPENROUTER_REASONING=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

INDEKS_HARGA_WILAYAH=1.0

# Peta Harga Tanah: API penyedia data harga tanah (kosongkan untuk memakai data tersimpan).
# Format respons yang diharapkan: lihat README bagian "Peta Harga Tanah".
